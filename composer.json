{
    "name": "candeno/js-localization",
    "version": "1.0.1",
    "description": "Laravel package to provide localizations to the Javascript code.",
    "keywords": ["laravel", "javascript", "localization", "translation", "messages"],
    "license": "MIT",
    "authors": [
        {
            "name": "Andy Wermke",
            "email": "andy@dev.next-step-software.com"
        }
    ],
    "require": {
        "php": ">=7.3.0",
        "illuminate/support": "6.*|7.*|8.*|9.*|10.*|11.*|12.*"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "JsLocalization\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "extra": {
        "component": "package",
        "frameworks": ["Laravel 7", "Laravel 8", "Laravel 9", "Laravel 10", "Laravel 11", "Laravel 12"]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
